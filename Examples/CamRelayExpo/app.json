{
  "expo": {
    "name": "CamRelay Expo",
    "slug": "camrelay-expo-example",
    "version": "1.0.0",
    "scheme": "org.camrelay.expo",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "ios": {
      "bundleIdentifier": "org.camrelay.expo",
      "supportsTablet": false
    },
    "android": {
      "package": "org.camrelay.expo"
    },
    "plugins": [
      [
        "react-native-vision-camera",
        {
          "cameraPermissionText": "Allow CamRelay Expo to display the camera feed.",
          "enableMicrophonePermission": false,
          "enableFrameProcessors": false
        }
      ]
    ]
  }
}
